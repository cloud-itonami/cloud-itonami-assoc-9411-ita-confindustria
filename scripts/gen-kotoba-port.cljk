#!/usr/bin/env kbb
;; scripts/gen-kotoba-port.cljk — write the two derived readings of the
;; Confindustria catalog from data/datascript-tx.edn.
;;
;;   kbb --backend sci scripts/gen-kotoba-port.cljk           rewrite both
;;   kbb --backend sci scripts/gen-kotoba-port.cljk --check   exit 1 if either file on disk
;;                                              is not what this would write
;;
;; Ported from cloud-itonami-assoc-9411-mex-coparmex (which took it from
;; -can-chamber, -zaf-busa, -cri-uccaep, -fin-ek and -sau-fsc). This repo's
;; port was typed by hand in July and had the same bug as the siblings':
;; `by-topic-id` answered only position 0, so
;; (by-topic-id "confindustria" "governance" 1) was none although both
;; entries carried :governance. Generating the port from the
;; data is what fixes that and keeps it fixed.
;;
;; BOTH readings are generated, not just the Kotoba one, because the parity
;; suite that would compare a hand-typed Clojure reading against the port does
;; not run in this repository: the owner's 2026-09-10 instruction renamed
;; .clj/.cljc to .kotoba across the workspace, so `kbb -M:test` finds no test
;; namespace (measured 2026-09-24 on this repo's main before this change:
;; "kbb test: 0 test namespace(s) found", exit 1). So both readings are generated from
;; the one data file, and `--check` says whether either has drifted. The facts
;; are authored once, in data/datascript-tx.edn, and nowhere else.

(ns gen-kotoba-port
  (:require [kotoba.lang.edn :as edn]
            [clojure.string :as str]
            ["fs" :as fs]))

(def argv (vec (remove #(str/ends-with? % "gen-kotoba-port.cljs")
                       (drop 2 (js->clj (.-argv js/process))))))
(def check? (some #{"--check"} argv))

(def data-path "data/datascript-tx.edn")
(def out-path "src/association_facts.kotoba")
(def cljc-path "src/association/facts.kotoba")
(def slug "confindustria")

(def fields
  "Emitted in this order. `entry-field` is asked by name, so the order is only
   the order of the cond branches, but keeping it fixed keeps the diff of a
   regenerated port readable."
  ["id" "title" "association" "isic" "country" "kind" "url" "url-provenance"
   "source-article" "source-quote" "established-date" "last-revised-date"
   "date-unknown-because" "date-precision" "retrieved-at"])

(defn- field-value [e f]
  (let [v (get e (keyword "association-rule" f))]
    (cond (nil? v) nil (keyword? v) (name v) :else (str v))))

(defn- lit
  "A Kotoba string literal. `\\\"` inside a string literal is admitted by `amu
   check` -- measured in the sibling this was ported from, whose Gazette notice
   puts a name in quotation marks. No span in THIS catalog contains a double
   quote, so the escape is carried rather than exercised; it is kept so that a
   later entry whose source does use one is not silently mangled.

   A backslash is still refused: no source in this catalog contains one, so
   admitting it would mean shipping an escape rule nothing has exercised."
  [s]
  (when (str/includes? s "\\")
    (throw (ex-info (str "a backslash in catalog text would need an escape rule "
                         "this generator has never had a source to test: " s) {})))
  (str "\"" (str/replace s "\"" "\\\"") "\""))

(def some- "(option-some-of [:option :string] ")
(def none "(option-none-of [:option :string])")

(defn- entry-fn [i e]
  (str "(defn entry-field-" i " [f :string] [:option :string]\n"
       "  (cond\n"
       (str/join "\n"
                 (for [f fields :let [v (field-value e f)] :when (some? v)]
                   (str "    (string=? f " (lit f) ") " some- (lit v) ")")))
       "\n    :else " none "))\n"))

(defn- dispatch [fname args body-for-i n tail]
  (str "(defn " fname " " args " [:option :string]\n"
       "  (if (valid-entry? a i)\n"
       "    (cond\n"
       (str/join "\n" (for [i (range n)] (str "      (= i " i ") " (body-for-i i))))
       "\n      :else " none ")\n"
       "    " tail "))\n"))

(defn- render [entries]
  (let [n (count entries)
        topics (mapv #(mapv name (:association-rule/topic %)) entries)]
    (str
     ";; The Confindustria source catalog, as Kotoba.\n"
     ";;\n"
     ";; GENERATED by scripts/gen-kotoba-port.cljk from data/datascript-tx.edn.\n"
     ";; So is the Clojure reading in src/association/facts.kotoba. The facts\n"
     ";; are authored once, in the data file, and nowhere else; this one also\n"
     ";; reaches the Kotoba oracle, wasm and both native ISAs. Do not hand-edit\n"
     ";; either -- run the generator, and `--check` will tell you if someone did.\n"
     ";;\n"
     ";; `:topic` is a SET in the Clojure reading. A set has no order and `topic`\n"
     ";; is indexed by position, so the generator uses the order the data file\n"
     ";; writes. `by-topic-id` answers by name and is unaffected.\n"
     ";;\n"
     ";; The parity suite that used to compare these two files does not run in\n"
     ";; this repository -- see the generator's header. `--check` replaces it:\n"
     ";; both readings are regenerated and compared to what is on disk.\n"
     "\n"
     "(ns association-facts\n"
     "  (:export [main association-covered? entry-count entry-field topic-count\n"
     "            topic by-topic-count by-topic-id coverage-note]))\n"
     "\n"
     "(defn association-covered? [a :string] :bool (string=? a " (lit slug) "))\n"
     "\n"
     "(defn entry-count [a :string] :i64 (if (association-covered? a) " n " 0))\n"
     "\n"
     "(defn valid-entry? [a :string i :i64] :bool\n"
     "  (if (association-covered? a) (if (< i 0) false (< i " n ")) false))\n"
     "\n"
     (str/join "\n" (map-indexed entry-fn entries))
     "\n"
     (dispatch "entry-field" "[a :string i :i64 f :string]"
               #(str "(entry-field-" % " f)") n none)
     "\n"
     "(defn topic-count [a :string i :i64] :i64\n"
     "  (if (valid-entry? a i)\n"
     "    (cond\n"
     (str/join "\n" (for [i (range n)] (str "      (= i " i ") " (count (nth topics i)))))
     "\n      :else 0)\n"
     "    0))\n"
     "\n"
     ;; `topic` is (entry, position) -> name. Emitted position-major so that a
     ;; catalog whose entries carry different topic sets still renders.
     "(defn topic [a :string i :i64 t :i64] [:option :string]\n"
     "  (if (valid-entry? a i)\n"
     "    (cond\n"
     (str/join "\n"
               (for [i (range n)]
                 (str "      (= i " i ") (cond\n"
                      (str/join "\n"
                                (for [[t nm] (map-indexed vector (nth topics i))]
                                  (str "        (= t " t ") " some- (lit nm) ")")))
                      "\n        :else " none ")")))
     "\n      :else " none ")\n"
     "    " none "))\n"
     "\n"
     (let [by-topic (reduce (fn [m [i ts]] (reduce #(update %1 %2 (fnil conj []) i) m ts))
                            {} (map-indexed vector topics))]
       (str
        "(defn by-topic-count [a :string candidate :string] :i64\n"
        "  (if (association-covered? a)\n"
        "    (cond\n"
        (str/join "\n" (for [[t is] (sort-by key by-topic)]
                         (str "      (string=? candidate " (lit t) ") " (count is))))
        "\n      :else 0)\n"
        "    0))\n"
        "\n"
        "(defn by-topic-id [a :string candidate :string i :i64] [:option :string]\n"
        "  (if (association-covered? a)\n"
        "    (cond\n"
        (str/join "\n"
                  (for [[t is] (sort-by key by-topic)]
                    (str "      (string=? candidate " (lit t) ") (cond\n"
                         (str/join "\n"
                                   (for [[pos ei] (map-indexed vector is)]
                                     (str "        (= i " pos ") (entry-field a " ei " \"id\")")))
                         "\n        :else " none ")")))
        "\n      :else " none ")\n"
        "    " none "))\n"))
     "\n"
     "(defn coverage-note [a :string] [:option :string]\n"
     "  (if (association-covered? a)\n"
     "    " some- "\n"
     "      " (lit (str "cloud-itonami-assoc-9411-ita-confindustria Wave 0 (ADR-2607141700): "
                        n " Confindustria entries, each citing a "
                        "confindustria.it page with the verbatim span it rests on. "
                        "Extend data/datascript-tx.edn and regenerate; "
                        "never fabricate an id/url.")) ")\n"
     "    " none "))\n"
     "\n"
     "(defn main [] :i64 0)\n")))


;; ---------------------------------------------------------------- the Clojure
;; reading. Emitted as EDN-ish Clojure text rather than `pr-str` of the parsed
;; data, because the source file is read by people: `pr-str` would put a
;; ten-entry catalog on one line and make every future diff unreadable.
;;
;; `:topic` is written as a SET here and as a VECTOR in the data file. That is
;; not a discrepancy to fix: the data file has to fix an order for the port to
;; index by position, and the Clojure reading has no such need, so it says the
;; true thing (an unordered set) while the port says the useful one.

(defn- clj-lit
  "A Clojure literal for a catalog value. Keywords keep their colon; strings are
   quoted with `pr-str`, which is the reader's own escaping rather than a rule
   invented here."
  [v]
  (cond (nil? v) "nil" (keyword? v) (str v) :else (pr-str v)))

(def ^:private clj-fields
  ["id" "title" "association" "isic" "country" "kind" "url" "url-provenance"
   "source-article" "source-quote" "established-date" "last-revised-date"
   "date-unknown-because" "date-precision" "retrieved-at"])

(defn- clj-entry [e]
  (let [present (for [f clj-fields
                      :let [v (get e (keyword "association-rule" f))]
                      :when (some? v)]
                  (str "      :association-rule/" f " " (clj-lit v)))
        topics (:association-rule/topic e)]
    (str "    {\n" (str/join "\n" present) "\n"
         "      :association-rule/topic #{"
         (str/join " " (map str topics)) "}}")))

(defn- render-clj [entries]
  (str
   "(ns association.facts\n"
   "  \"Industry rule/history catalog for Confindustria (Confederazione\n"
   "  Generale dell'Industria Italiana), an industry-association-level source per\n"
   "  ADR-2607141700 (cloud-itonami-compliance-fact-federation), aligned to\n"
   "  ISIC 9411 (activities of business, employers, and professional\n"
   "  membership organizations). Italy has real, individually verified\n"
   "  facts across all three axes: country (cloud-itonami-iso3166-ita\n"
   "  statute.facts), municipality\n"
   "  (cloud-itonami-municipality-ita-roma), and association (this\n"
   "  entry).\n"
   "\n"
   "  GENERATED by scripts/gen-kotoba-port.cljk from data/datascript-tx.edn,\n"
   "  together with the Kotoba port in src/association_facts.kotoba. Do not\n"
   "  hand-edit; add facts to the data file and regenerate.\n"
   "\n"
   "  Every entry carries the page it came from (:source-article) and the\n"
   "  verbatim span the claim rests on (:source-quote), and\n"
   "  `kbb --backend sci scripts/verify-catalog.cljk --live` fetches each :url and requires\n"
   "  that span to still be in it. Reachability is not support: a URL that\n"
   "  returns 200 without the claim reads exactly like one that carries it.\n"
   "\n"
   "  No personal names of office-holders are persisted here.\n"
   "\n"
   "  An association not in `catalog` has NO spec-basis, full stop; never\n"
   "  fabricate one.\"\n"
   "  (:require [clojure.string]))\n"
   "\n"
   "(def catalog\n"
   "  \"association-slug -> vector of association-rule entries.\"\n"
   "  {" (pr-str slug) "\n"
   "   [\n"
   (str/join "\n" (map clj-entry entries))
   "]})\n"
   "\n"
   "(defn spec-basis [association] (get catalog association))\n"
   "\n"
   "(defn coverage\n"
   "  ([] (coverage (keys catalog)))\n"
   "  ([associations]\n"
   "   (let [have (filter catalog associations)\n"
   "         missing (remove catalog associations)]\n"
   "     {:requested (count associations)\n"
   "      :covered (count have)\n"
   "      :covered-associations (vec (sort have))\n"
   "      :missing-associations (vec (sort missing))\n"
   "      :note (str \"cloud-itonami-assoc-9411-ita-confindustria Wave 0 (ADR-2607141700): \"\n"
   "                 (count (get catalog " (pr-str slug) ")) \" Confindustria entries, each citing \"\n"
   "                 \"a source with the page and the verbatim span it rests on. \"\n"
   "                 \"Extend data/datascript-tx.edn and regenerate; never \"\n"
   "                 \"fabricate an id/url.\")})))\n"
   "\n"
   "(defn by-topic [association topic]\n"
   "  (filterv #(contains? (:association-rule/topic %) topic) (spec-basis association)))\n"))

;; ---------------------------------------------------------------------------

(defn- check-one [path text]
  (let [on-disk (try (fs/readFileSync path "utf8") (catch :default _ nil))]
    (when-not (= on-disk text) path)))

(let [entries (edn/read-string (fs/readFileSync data-path "utf8"))
      _ (when-not (and (vector? entries) (seq entries))
          (println "REFUSED:" data-path "is not a non-empty vector")
          (.exit js/process 2))
      text (render entries)
      clj  (render-clj entries)]
  (if check?
    (let [stale (remove nil? [(check-one out-path text) (check-one cljc-path clj)])]
      (if (empty? stale)
        (do (println (str "ok — both readings match the generator ("
                          (count entries) " entries)")) (.exit js/process 0))
        (do (println (str "STALE: " (str/join ", " stale)
                          " is not what the generator writes."))
            (println "  run: kbb --backend sci scripts/gen-kotoba-port.cljk")
            (.exit js/process 1))))
    (do (fs/writeFileSync out-path text)
        (fs/writeFileSync cljc-path clj)
        (println (str "wrote " out-path " and " cljc-path
                      " — " (count entries) " entries")))))
