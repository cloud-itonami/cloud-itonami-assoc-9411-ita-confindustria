(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "constitution") 5
      (string=? candidate "governance") 11
      (string=? candidate "history") 9
      (string=? candidate "international") 1
      (string=? candidate "labor") 1
      (string=? candidate "membership") 4
      (string=? candidate "policy") 2
      (string=? candidate "statute") 5
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
      (string=? candidate "constitution") (cond
        (= i 0) (entry-field a 1 "id")
        (= i 1) (entry-field a 8 "id")
        (= i 2) (entry-field a 10 "id")
        (= i 3) (entry-field a 11 "id")
        (= i 4) (entry-field a 16 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 2 "id")
        (= i 2) (entry-field a 3 "id")
        (= i 3) (entry-field a 4 "id")
        (= i 4) (entry-field a 6 "id")
        (= i 5) (entry-field a 9 "id")
        (= i 6) (entry-field a 12 "id")
        (= i 7) (entry-field a 13 "id")
        (= i 8) (entry-field a 14 "id")
        (= i 9) (entry-field a 15 "id")
        (= i 10) (entry-field a 19 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "history") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        (= i 2) (entry-field a 2 "id")
        (= i 3) (entry-field a 3 "id")
        (= i 4) (entry-field a 4 "id")
        (= i 5) (entry-field a 5 "id")
        (= i 6) (entry-field a 6 "id")
        (= i 7) (entry-field a 7 "id")
        (= i 8) (entry-field a 18 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "international") (cond
        (= i 0) (entry-field a 5 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "labor") (cond
        (= i 0) (entry-field a 1 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "membership") (cond
        (= i 0) (entry-field a 10 "id")
        (= i 1) (entry-field a 12 "id")
        (= i 2) (entry-field a 16 "id")
        (= i 3) (entry-field a 17 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "policy") (cond
        (= i 0) (entry-field a 17 "id")
        (= i 1) (entry-field a 18 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "statute") (cond
        (= i 0) (entry-field a 3 "id")
        (= i 1) (entry-field a 8 "id")
        (= i 2) (entry-field a 9 "id")
        (= i 3) (entry-field a 13 "id")
        (= i 4) (entry-field a 15 "id")
        :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] 
      "cloud-itonami-assoc-9411-ita-confindustria Wave 0 (ADR-2607141700): 20 Confindustria entries, each citing a confindustria.it page with the verbatim span it rests on. Extend data/datascript-tx.edn and regenerate; never fabricate an id/url.")
    (option-none-of [:option :string])))

