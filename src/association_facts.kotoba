(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (entry-field-0 f)
      (= i 1) (entry-field-1 f)
      (= i 2) (entry-field-2 f)
      (= i 3) (entry-field-3 f)
      (= i 4) (entry-field-4 f)
      (= i 5) (entry-field-5 f)
      (= i 6) (entry-field-6 f)
      (= i 7) (entry-field-7 f)
      (= i 8) (entry-field-8 f)
      (= i 9) (entry-field-9 f)
      (= i 10) (entry-field-10 f)
      (= i 11) (entry-field-11 f)
      (= i 12) (entry-field-12 f)
      (= i 13) (entry-field-13 f)
      (= i 14) (entry-field-14 f)
      (= i 15) (entry-field-15 f)
      (= i 16) (entry-field-16 f)
      (= i 17) (entry-field-17 f)
      (= i 18) (entry-field-18 f)
      (= i 19) (entry-field-19 f)
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

